# BACKEND SERVER CONFIGURATION
PORT=5050
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/green_gate_advisory?retryWrites=true&w=majority
MONGO_URI=

# Allowed Client Origins for CORS (comma-separated for public website and admin panel)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Session / JWT Secret for secure Admin authentication
SESSION_SECRET=green-gate-advisory-super-secure-session-secret-2026

# SMTP Mail Notification Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Green Gate Advisory" <no-reply@greengateadvisory.com>
ENQUIRY_RECEIVER_EMAIL=contact@greengateadvisory.com
